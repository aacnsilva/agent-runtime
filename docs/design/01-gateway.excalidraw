    {
      "id": "-dgiSS50qgQHlFRUKkoyp",
      "type": "text",
      "x": 60,
      "y": 655,
      "width": 626.053955078125,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
