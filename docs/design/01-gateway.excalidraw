      "seed": 1188246664,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795184947099,
      "link": null,
      "locked": false,
      "text": "1. Tenant ctx comes from the credential, never from the request body",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "1. Tenant ctx comes from the credential, never from the request body",
      "lineHeight": 1.25
    },
    {
      "id": "r5W11t0a0xZuze8NEawHm",
      "type": "text",
      "x": 60,
      "y": 687,
      "width": 655.2317504882812,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 713963512,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795184947099,
      "link": null,
      "locked": false,
      "text": "2. Gateway processes are stateless: all state lives in the three stores",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "2. Gateway processes are stateless: all state lives in the three stores",
      "lineHeight": 1.25
    },
    {
      "id": "qs573TYQMrF0m-c7JO5Of",
      "type": "text",
      "x": 60,
      "y": 719,
      "width": 648.373779296875,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 915104648,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795184947100,
      "link": null,
      "locked": false,
      "text": "3. A run outlives its connection: clients can drop and resume the stream",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "3. A run outlives its connection: clients can drop and resume the stream",
      "lineHeight": 1.25
    },
    {
      "id": "HC4Mt9hYSaTDkCDgGcIiU",
      "type": "text",
      "x": 60,
      "y": 751,
      "width": 784.6329345703125,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1425307896,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795184947100,
      "link": null,
      "locked": false,
      "text": "4. AuthZ is two checks: may this principal do this action, and does it own this resource",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "4. AuthZ is two checks: may this principal do this action, and does it own this resource",
      "lineHeight": 1.25
    },
