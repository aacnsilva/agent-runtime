      "text": "chunks + citations, marked as untrusted data",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "chunks + citations, marked as untrusted data",
      "lineHeight": 1.25
    },
    {
      "id": "OUvrFZ-JCTOgJOH-ngTSa",
      "type": "rectangle",
      "x": 40,
      "y": 575,
