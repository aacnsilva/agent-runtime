    {
      "id": "Vafk8Lmxr7eYzZxQwZLOu",
      "type": "text",
      "x": 40,
      "y": 655,
      "width": 788.556884765625,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 878666829,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795190993714,
      "link": null,
      "locked": false,
      "text": "1. The store is picked from the tenant in the route. No query can name another tenant.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "1. The store is picked from the tenant in the route. No query can name another tenant.",
      "lineHeight": 1.25
    },
    {
      "id": "Qf5YPJMf6fcnDkJ5T1pwH",
      "type": "text",
      "x": 40,
      "y": 687,
      "width": 817.03271484375,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1324454659,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795190993714,
      "link": null,
      "locked": false,
      "text": "2. A document restricted to plans is invisible to every other plan, and to callers with none.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "2. A document restricted to plans is invisible to every other plan, and to callers with none.",
      "lineHeight": 1.25
    },
    {
      "id": "ZnWbXU0nWZMEdi32WPxfT",
      "type": "text",
      "x": 40,
      "y": 719,
      "width": 854.54443359375,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 15159981,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795190993714,
      "link": null,
      "locked": false,
      "text": "3. A stored vector is compared only when it came from the same embedding model as the query.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "3. A stored vector is compared only when it came from the same embedding model as the query.",
      "lineHeight": 1.25
    },
    {
      "id": "RJZ0m6JLbM5oNH4QpYEXb",
      "type": "text",
      "x": 40,
      "y": 751,
      "width": 537.0625,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1643002531,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795190993715,
      "link": null,
      "locked": false,
      "text": "4. Retrieved text is data for the model, never instructions.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "4. Retrieved text is data for the model, never instructions.",
      "lineHeight": 1.25
    },
    {
      "id": "gsYlQW1uXEZL0TalZi9w3",
      "type": "text",
      "x": 40,
      "y": 783,
      "width": 789.8528442382812,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 656569613,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795190993715,
      "link": null,
      "locked": false,
      "text": "5. Every chunk of the tenant is scored on each search: built for thousands, not millions.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "5. Every chunk of the tenant is scored on each search: built for thousands, not millions.",
