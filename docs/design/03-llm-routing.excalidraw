    {
      "id": "xm7bF72R-ZojyFzynrY9W",
      "type": "text",
      "x": 40,
      "y": 685,
      "width": 844.3744506835938,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1539622189,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795190993640,
      "link": null,
      "locked": false,
      "text": "1. Agents name a tier, never a model. An eval run may ask for another tier the tenant allows.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "1. Agents name a tier, never a model. An eval run may ask for another tier the tenant allows.",
      "lineHeight": 1.25
    },
    {
      "id": "x3UgEUxfxfITTeyDTcJmg",
      "type": "text",
      "x": 40,
      "y": 717,
      "width": 833.3585205078125,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1136078883,
      "version": 2,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795190993640,
      "link": null,
      "locked": false,
      "text": "2. A model that fails three times in a minute is skipped for thirty seconds, for every worker instance.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "2. A model that fails three times in a minute is skipped for thirty seconds, for every worker instance.",
      "lineHeight": 1.25
    },
    {
      "id": "nYpMAORv2kKHEz7AO6a1M",
      "type": "text",
      "x": 40,
      "y": 749,
      "width": 898.230224609375,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1521325965,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795190993641,
      "link": null,
      "locked": false,
      "text": "3. The system prompt and the tool list are sent as cached blocks; cost counts cache reads apart.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "3. The system prompt and the tool list are sent as cached blocks; cost counts cache reads apart.",
      "lineHeight": 1.25
    },
    {
      "id": "note4streamed0000000a",
      "type": "text",
      "x": 40,
      "y": 781,
      "width": 898.230224609375,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1521325982,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795190993641,
      "link": null,
      "locked": false,
      "text": "4. Every call is streamed: twenty seconds to start, then thirty seconds of silence ends it.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "4. Every call is streamed: twenty seconds to start, then thirty seconds of silence ends it.",
      "lineHeight": 1.25
    },
    {
      "id": "note5refused00000000b",
      "type": "text",
      "x": 40,
      "y": 813,
      "width": 898.230224609375,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1521325999,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795190993641,
      "link": null,
      "locked": false,
      "text": "5. A refused request (4xx) or a caller who left never opens a circuit; a caller who left cancels the call.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "5. A refused request (4xx) or a caller who left never opens a circuit; a caller who left cancels the call.",
      "lineHeight": 1.25
    },
