    {
      "id": "LOgooUVCA-qPi6lQ4R8cW",
      "type": "text",
      "x": 40,
      "y": 685,
      "width": 758.2630615234375,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1990353032,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795184947288,
      "link": null,
      "locked": false,
      "text": "1. Callers ask for a capability tier, never a model name. Models change; tiers do not.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "1. Callers ask for a capability tier, never a model name. Models change; tiers do not.",
      "lineHeight": 1.25
    },
    {
      "id": "mw9c80i2R_Ga8OU5ozCiv",
      "type": "text",
      "x": 40,
      "y": 717,
      "width": 722.983154296875,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 60279800,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795184947288,
      "link": null,
      "locked": false,
      "text": "2. Fallbacks stay inside the tenant's allowed set, even when everything is failing.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "2. Fallbacks stay inside the tenant's allowed set, even when everything is failing.",
      "lineHeight": 1.25
    },
    {
      "id": "lAKWTySE_yNx-cv5KlY8I",
      "type": "text",
      "x": 40,
      "y": 749,
      "width": 751.5850830078125,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2073366408,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795184947288,
      "link": null,
      "locked": false,
      "text": "3. No silent retry once tokens have streamed: surface the error to the agent loop.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "3. No silent retry once tokens have streamed: surface the error to the agent loop.",
      "lineHeight": 1.25
    },
