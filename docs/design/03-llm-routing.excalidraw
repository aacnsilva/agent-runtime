      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795185867622,
      "link": null,
      "locked": false,
      "text": "4. The router guards the tenant pool in EUR; message caps per subject live in the gateway.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "4. The router guards the tenant pool in EUR; message caps per subject live in the gateway.",
      "lineHeight": 1.25
    },
