    {
      "id": "t_cHR05OzMtfYtLgFQgNp",
      "type": "text",
      "x": 40,
      "y": 685,
      "width": 758.2630615234375,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 83325409,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795185867621,
      "link": null,
      "locked": false,
      "text": "1. Callers ask for a capability tier, never a model name. Models change; tiers do not.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "1. Callers ask for a capability tier, never a model name. Models change; tiers do not.",
      "lineHeight": 1.25
    },
    {
      "id": "pihwjJymc9U6rUE3oaaC8",
      "type": "text",
      "x": 40,
      "y": 717,
      "width": 722.983154296875,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2111428783,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795185867621,
      "link": null,
      "locked": false,
      "text": "2. Fallbacks stay inside the tenant's allowed set, even when everything is failing.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "2. Fallbacks stay inside the tenant's allowed set, even when everything is failing.",
      "lineHeight": 1.25
    },
    {
      "id": "TY6c-4vIxeFPljhidNrKW",
      "type": "text",
      "x": 40,
      "y": 749,
      "width": 751.5850830078125,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1204850113,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795185867621,
      "link": null,
      "locked": false,
      "text": "3. No silent retry once tokens have streamed: surface the error to the agent loop.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "3. No silent retry once tokens have streamed: surface the error to the agent loop.",
      "lineHeight": 1.25
    },
    {
      "id": "pQWqTtlvORVkkWXYLYept",
      "type": "text",
      "x": 40,
      "y": 781,
      "width": 832.4765625,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1167649487,
