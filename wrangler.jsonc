{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-runtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [
      { "name": "LEDGER", "class_name": "Ledger" },
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "METRICS", "class_name": "Metrics" },
      { "name": "SUBJECT", "class_name": "Subject" },
      { "name": "SESSION", "class_name": "Session" },
      { "name": "KNOWLEDGE", "class_name": "Knowledge" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Ledger", "Registry", "Metrics", "Subject", "Session", "Knowledge"],
    },
  ],
  "env": {
    "dev": {
      "name": "agent-runtime-dev",
      "durable_objects": {
        "bindings": [
          { "name": "LEDGER", "class_name": "Ledger" },
          { "name": "REGISTRY", "class_name": "Registry" },
          { "name": "METRICS", "class_name": "Metrics" },
          { "name": "SUBJECT", "class_name": "Subject" },
          { "name": "SESSION", "class_name": "Session" },
          { "name": "KNOWLEDGE", "class_name": "Knowledge" },
        ],
      },
    },
  },
}
